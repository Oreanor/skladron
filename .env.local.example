# Скопируй в .env.local и подставь свои значения из Supabase → Project Settings → API.
# Без этих переменных игра работает локально, состояние лежит в localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Телеграм-бот для извещений (необязателен: без него игра просто молчит)
# NEXT_PUBLIC_TELEGRAM_BOT=skladron_bot        # имя бота без @, для ссылки привязки
# TELEGRAM_BOT_TOKEN=123456:AA...              # токен от @BotFather, только на сервере
# TELEGRAM_WEBHOOK_SECRET=любая-строка          # её же передать телеграму при setWebhook
# SUPABASE_SERVICE_ROLE_KEY=...                # сервисный ключ Supabase, только на сервере
# NEXT_PUBLIC_SITE_URL=https://skladron.vercel.app
